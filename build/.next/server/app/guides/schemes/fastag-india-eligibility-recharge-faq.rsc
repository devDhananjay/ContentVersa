26:["$","div",null,{"className":"space-y-8","children":[["$","section","What FASTag is (and why highways need it)",{"className":"space-y-3","children":[["$","h2",null,{"className":"font-display text-xl font-bold tracking-tight","children":"What FASTag is (and why highways need it)"}],[["$","p","FASTag is an RFID sticker linked to a pr",{"className":"text-muted-foreground leading-relaxed","children":"FASTag is an RFID sticker linked to a prepaid wallet or bank account. Toll plazas on many national highways scan the tag so vehicles can pass without cash queues. The system is run through NHAI / IHMCL frameworks with bank and payment partners — issuer rules and fees can differ."}],["$","p","Cars, commercial vehicles, and many two-",{"className":"text-muted-foreground leading-relaxed","children":"Cars, commercial vehicles, and many two-wheelers on notified stretches are expected to use FASTag. Driving without a working tag can mean higher cash toll or penalties depending on plaza policy. Treat this page as an educational explainer; always confirm live rules on official portals before you buy or travel."}]],null,["$","div",null,{"className":"container flex justify-center py-4 !px-0","data-cv-ad-zone":"hub-editorial","children":["$","aside",null,{"aria-label":"Advertisement","data-cv-ad-zone":"mrec","className":"mx-auto flex w-fit max-w-full flex-col items-center","children":[["$","p",null,{"className":"mb-1.5 text-center text-[9px] font-medium uppercase tracking-[0.14em] text-muted-foreground/70","children":"Ad"}],["$","$L24",null,{"slotKey":"hub","width":300,"height":250}]]}]}]]}],["$","section","Who needs FASTag (eligibility in plain English)",{"className":"space-y-3","children":[["$","h2",null,{"className":"font-display text-xl font-bold tracking-tight","children":"Who needs FASTag (eligibility in plain English)"}],[["$","p","If you use national highways regularly —",{"className":"text-muted-foreground leading-relaxed","children":"If you use national highways regularly — weekend trips, interstate office travel, logistics, taxis, or intercity buses — FASTag usually saves time and avoids cash-lane delays. Occasional city-only drivers may still want one for rare highway journeys so they are not stuck at a plaza without a working tag."}],["$","p","You generally need a valid vehicle regis",{"className":"text-muted-foreground leading-relaxed","children":"You generally need a valid vehicle registration (RC), a mobile number for OTP/alerts, and a bank account or wallet supported by an authorised FASTag issuer. Commercial fleets often manage multiple tags under a business account — check your issuer’s fleet product separately."}]],["$","ul",null,{"className":"list-disc space-y-1.5 pl-5 text-sm text-muted-foreground","children":[["$","li","Keep RC details ready when activating (registration number must match)",{"children":"Keep RC details ready when activating (registration number must match)"}],["$","li","Affix the tag on the windscreen exactly as the issuer instructs — wrong placement fails reads",{"children":"Affix the tag on the windscreen exactly as the issuer instructs — wrong placement fails reads"}],["$","li","One FASTag maps to one vehicle registration in normal retail use",{"children":"One FASTag maps to one vehicle registration in normal retail use"}],["$","li","Two-wheeler FASTag availability depends on issuer and plaza network — confirm before you buy",{"children":"Two-wheeler FASTag availability depends on issuer and plaza network — confirm before you buy"}]]}],null]}],["$","section","How to buy and activate FASTag",{"className":"space-y-3","children":[["$","h2",null,{"className":"font-display text-xl font-bold tracking-tight","children":"How to buy and activate FASTag"}],["$L2d","$L2e"],"$L2f",null]}],"$L30","$L31","$L32"]}]
27:["$","section",null,{"className":"space-y-4","children":[["$","h2",null,{"className":"font-display text-xl font-bold tracking-tight","children":"Frequently asked questions"}],["$","div",null,{"className":"space-y-3","children":[["$","div","Is FASTag mandatory in India?",{"ref":"$undefined","className":"rounded-2xl border bg-card text-card-foreground shadow-[var(--v2-shadow-sm)]","children":[["$","div",null,{"ref":"$undefined","className":"flex flex-col space-y-1.5 p-6 pb-2","children":["$","h3",null,{"ref":"$undefined","className":"font-display font-semibold tracking-tight text-base","children":"Is FASTag mandatory in India?"}]}],["$","div",null,{"ref":"$undefined","className":"p-6 pt-0 text-sm text-muted-foreground leading-relaxed","children":"On most national highway toll plazas, FASTag is the expected payment method. Cash lanes may charge a higher fee or be limited. Rules can change — confirm on NHAI / IHMCL channels for your route."}]]}],["$","div","How do I recharge FASTag?",{"ref":"$undefined","className":"rounded-2xl border bg-card text-card-foreground shadow-[var(--v2-shadow-sm)]","children":[["$","div",null,{"ref":"$undefined","className":"flex flex-col space-y-1.5 p-6 pb-2","children":["$","h3",null,{"ref":"$undefined","className":"font-display font-semibold tracking-tight text-base","children":"How do I recharge FASTag?"}]}],["$","div",null,{"ref":"$undefined","className":"p-6 pt-0 text-sm text-muted-foreground leading-relaxed","children":"Use your issuer bank’s app, net banking, or UPI linked to the FASTag wallet. After payment, wait a few minutes and verify the balance in the issuer app before a long trip."}]]}],["$","div","Why is my FASTag blacklisted?",{"ref":"$undefined","className":"rounded-2xl border bg-card text-card-foreground shadow-[var(--v2-shadow-sm)]","children":[["$","div",null,{"ref":"$undefined","className":"flex flex-col space-y-1.5 p-6 pb-2","children":["$","h3",null,{"ref":"$undefined","className":"font-display font-semibold tracking-tight text-base","children":"Why is my FASTag blacklisted?"}]}],["$","div",null,{"ref":"$undefined","className":"p-6 pt-0 text-sm text-muted-foreground leading-relaxed","children":"Common reasons: low or zero balance, KYC pending, mismatched vehicle number, or issuer-side holds. Top up, complete KYC in the issuer app, then wait for the blacklist to clear (can take hours)."}]]}],["$","div","Can one FASTag be used on two vehicles?",{"ref":"$undefined","className":"rounded-2xl border bg-card text-card-foreground shadow-[var(--v2-shadow-sm)]","children":[["$","div",null,{"ref":"$undefined","className":"flex flex-col space-y-1.5 p-6 pb-2","children":["$","h3",null,{"ref":"$undefined","className":"font-display font-semibold tracking-tight text-base","children":"Can one FASTag be used on two vehicles?"}]}],["$","div",null,{"ref":"$undefined","className":"p-6 pt-0 text-sm text-muted-foreground leading-relaxed","children":"No. One FASTag is typically mapped to one registration number. Affixing the same tag on another vehicle can cause failed reads or account issues."}]]}],["$","div","What if the plaza deducted twice?",{"ref":"$undefined","className":"rounded-2xl border bg-card text-card-foreground shadow-[var(--v2-shadow-sm)]","children":[["$","div",null,{"ref":"$undefined","className":"flex flex-col space-y-1.5 p-6 pb-2","children":["$","h3",null,{"ref":"$undefined","className":"font-display font-semibold tracking-tight text-base","children":"What if the plaza deducted twice?"}]}],["$","div",null,{"ref":"$undefined","className":"p-6 pt-0 text-sm text-muted-foreground leading-relaxed","children":"Note plaza name, time, lane, and SMS. Raise a dispute with your FASTag issuer first with screenshots. Keep the toll receipt if any cash fallback was used."}]]}]]}]]}]
