30:["$","section","How to recharge FASTag (UPI, app, net banking)",{"className":"space-y-3","children":[["$","h2",null,{"className":"font-display text-xl font-bold tracking-tight","children":"How to recharge FASTag (UPI, app, net banking)"}],[["$","p","Recharge via the issuer’s app, UPI, or n",{"className":"text-muted-foreground leading-relaxed","children":"Recharge via the issuer’s app, UPI, or net banking. Set a low-balance alert so you are not stuck with a declined plaza read. After recharge, wait a few minutes and confirm balance in the issuer app — some wallets take a short settlement delay."}],["$","p","Before a long trip (especially festival ",{"className":"text-muted-foreground leading-relaxed","children":"Before a long trip (especially festival weekends), top up with a buffer above your expected tolls. Combine this with a fuel budget using ContentVerse India’s fuel price tool so cashflow surprises stay low."}]],["$","ul",null,{"className":"list-disc space-y-1.5 pl-5 text-sm text-muted-foreground","children":[["$","li","Enable SMS / push alerts for every plaza debit",{"children":"Enable SMS / push alerts for every plaza debit"}],["$","li","Keep a second payment method ready if your tag fails at a plaza",{"children":"Keep a second payment method ready if your tag fails at a plaza"}],["$","li","Avoid third-party “instant recharge agents” that ask for OTP",{"children":"Avoid third-party “instant recharge agents” that ask for OTP"}]]}],null]}]
31:["$","section","FASTag not working, blacklist, or double deduction",{"className":"space-y-3","children":[["$","h2",null,{"className":"font-display text-xl font-bold tracking-tight","children":"FASTag not working, blacklist, or double deduction"}],[["$","p","If a plaza does not open: slow down safe",{"className":"text-muted-foreground leading-relaxed","children":"If a plaza does not open: slow down safely, note plaza name, time, and lane, and check SMS. Common fixes — low balance top-up, wait for blacklist clear after KYC, re-affix tag if the windscreen film blocks RFID, or ask staff for the FASTag lane policy at that plaza."}],["$","p","If charged twice or charged while cash w",{"className":"text-muted-foreground leading-relaxed","children":"If charged twice or charged while cash was also taken, raise a dispute with your issuer with screenshots and timestamps. Official blacklist / KYC status lives with your bank issuer and NHAI–IHMCL support channels — ContentVerse India does not process disputes."}]],["$","ul",null,{"className":"list-disc space-y-1.5 pl-5 text-sm text-muted-foreground","children":[["$","li","Screenshot failed transactions before leaving the plaza area if safe",{"children":"Screenshot failed transactions before leaving the plaza area if safe"}],["$","li","Dispute first with the issuer app / helpline, not random social accounts",{"children":"Dispute first with the issuer app / helpline, not random social accounts"}],["$","li","Pair trip planning with fuel estimates on our Fuel Price tool",{"children":"Pair trip planning with fuel estimates on our Fuel Price tool"}]]}],null]}]
32:["$","section","Documents & checklist before a highway trip",{"className":"space-y-3","children":[["$","h2",null,{"className":"font-display text-xl font-bold tracking-tight","children":"Documents & checklist before a highway trip"}],[["$","p","A five-minute checklist prevents most FA",{"className":"text-muted-foreground leading-relaxed","children":"A five-minute checklist prevents most FASTag failures: confirm balance, confirm vehicle number in the app, confirm tag is affixed correctly, and save issuer helpline numbers offline. If you changed the windscreen recently, re-validate the tag — RFID placement is easy to get wrong after glass work."}]],["$","ul",null,{"className":"list-disc space-y-1.5 pl-5 text-sm text-muted-foreground","children":[["$","li","Balance ≥ expected tolls + buffer",{"children":"Balance ≥ expected tolls + buffer"}],["$","li","RC number matches app",{"children":"RC number matches app"}],["$","li","Phone has network for OTP if issuer asks mid-trip",{"children":"Phone has network for OTP if issuer asks mid-trip"}],["$","li","Alternate cash/UPI plan if plaza has issues",{"children":"Alternate cash/UPI plan if plaza has issues"}]]}],null]}]
