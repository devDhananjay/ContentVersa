2b:["$","div",null,{"className":"space-y-8","children":[["$","section","What EMI means for Indian borrowers",{"className":"space-y-3","children":[["$","h2",null,{"className":"font-display text-xl font-bold tracking-tight","children":"What EMI means for Indian borrowers"}],[["$","p","EMI (Equated Monthly Instalment) is the ",{"className":"text-muted-foreground leading-relaxed","children":"EMI (Equated Monthly Instalment) is the fixed amount you pay each month toward a loan — part interest, part principal. Home loans, car loans, personal loans, and many consumer durables use EMI structures. Understanding the trade-off between monthly comfort and total interest is the real skill, not just finding the lowest advertised EMI."}],["$","p","Use our free EMI calculator to compare s",{"className":"text-muted-foreground leading-relaxed","children":"Use our free EMI calculator to compare scenarios side by side, then verify numbers with the bank before signing. This guide is educational only — not a loan offer or credit advice."}]],null,null,["$","div",null,{"className":"container flex justify-center py-4 !px-0","data-cv-ad-zone":"hub-editorial","children":["$","aside",null,{"aria-label":"Advertisement","data-cv-ad-zone":"mrec","className":"mx-auto flex w-fit max-w-full flex-col items-center","children":[["$","p",null,{"className":"mb-1.5 text-center text-[9px] font-medium uppercase tracking-[0.14em] text-muted-foreground/70","children":"Ad"}],["$","$L32",null,{"slotKey":"hub","width":300,"height":250}]]}]}]]}],["$","section","EMI formula in plain English",{"className":"space-y-3","children":[["$","h2",null,{"className":"font-display text-xl font-bold tracking-tight","children":"EMI formula in plain English"}],[["$","p","EMI rises when principal or interest rat",{"className":"text-muted-foreground leading-relaxed","children":"EMI rises when principal or interest rate rises, and falls when tenure lengthens. A longer tenure spreads principal over more months, so the monthly hit looks smaller — but interest accumulates for longer. Always ask for total interest payable and the amortisation schedule, not only the EMI line on a sales flyer."}]],["$","ul",null,{"className":"list-disc space-y-1.5 pl-5 text-sm text-muted-foreground","children":[["$","li","Shorter tenure = higher EMI, usually lower total interest",{"children":"Shorter tenure = higher EMI, usually lower total interest"}],["$","li","Floating rates can change EMI or tenure mid-loan",{"children":"Floating rates can change EMI or tenure mid-loan"}],["$","li","Processing fees and insurance may sit outside the EMI",{"children":"Processing fees and insurance may sit outside the EMI"}]]}],null,null]}],["$","section","Practical planning tips before you borrow",{"className":"space-y-3","children":[["$","h2",null,{"className":"font-display text-xl font-bold tracking-tight","children":"Practical planning tips before you borrow"}],[["$","p","Keep total EMIs (existing + new) under a",{"className":"text-muted-foreground leading-relaxed","children":"Keep total EMIs (existing + new) under a comfortable share of take-home salary. Stress-test a 1–2% rate hike if the loan is floating. Prepayment can cut interest — check prepayment charges and whether the bank reduces tenure or EMI after you prepay."}],["$","p","Compare bank offers with the same princi",{"className":"text-muted-foreground leading-relaxed","children":"Compare bank offers with the same principal and tenure in our calculator, then confirm with Form 16 / salary slips the lender will underwrite against."}]],null,null,null]}],["$","section","First home-loan checklist (salaried)",{"className":"space-y-3","children":[["$","h2",null,{"className":"font-display text-xl font-bold tracking-tight","children":"First home-loan checklist (salaried)"}],["$L33"],"$L34",null,null]}],"$L35"]}]
