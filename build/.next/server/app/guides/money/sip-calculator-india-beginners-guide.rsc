26:["$","div",null,{"className":"space-y-8","children":[["$","section","What a SIP is (without jargon)",{"className":"space-y-3","children":[["$","h2",null,{"className":"font-display text-xl font-bold tracking-tight","children":"What a SIP is (without jargon)"}],[["$","p","A Systematic Investment Plan (SIP) inves",{"className":"text-muted-foreground leading-relaxed","children":"A Systematic Investment Plan (SIP) invests a fixed amount into a mutual fund at regular intervals — usually monthly. The habit matters as much as the product: automation reduces the urge to time the market on every headline."}],["$","p","Our SIP calculator projects how monthly ",{"className":"text-muted-foreground leading-relaxed","children":"Our SIP calculator projects how monthly investments might grow under an assumed annual return. It is for planning conversations — not a guarantee and not SEBI-registered advice."}]],null]}],["$","section","How to use the SIP calculator well",{"className":"space-y-3","children":[["$","h2",null,{"className":"font-display text-xl font-bold tracking-tight","children":"How to use the SIP calculator well"}],[["$","p","Enter monthly amount, expected annual re",{"className":"text-muted-foreground leading-relaxed","children":"Enter monthly amount, expected annual return %, and tenure in years. Review maturity value and estimated gains. Try conservative (8–10%), moderate (11–12%), and optimistic scenarios separately instead of one aggressive number."}],["$","p","Long horizons usually matter more than c",{"className":"text-muted-foreground leading-relaxed","children":"Long horizons usually matter more than chasing last year’s top fund. Revisit asset allocation annually — not every market dip."}]],null]}],["$","section","Beginner habits that actually stick",{"className":"space-y-3","children":[["$","h2",null,{"className":"font-display text-xl font-bold tracking-tight","children":"Beginner habits that actually stick"}],[["$","p","Automate the SIP on salary day. Keep an ",{"className":"text-muted-foreground leading-relaxed","children":"Automate the SIP on salary day. Keep an emergency buffer in safer instruments so you do not pause SIPs for every expense spike. Read the scheme document. If you need personalised advice, consult a SEBI-registered adviser."}]],["$","ul",null,{"className":"list-disc space-y-1.5 pl-5 text-sm text-muted-foreground","children":[["$","li","Start small, stay consistent",{"children":"Start small, stay consistent"}],["$","li","Increase SIP with salary hikes",{"children":"Increase SIP with salary hikes"}],["$","li","Do not confuse past returns with future results",{"children":"Do not confuse past returns with future results"}]]}]]}]]}]
