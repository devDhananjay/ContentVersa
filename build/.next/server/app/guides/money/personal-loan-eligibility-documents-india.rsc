21:T440,{"@context":"https://schema.org","@type":"Article","headline":"Personal Loan India 2026 — Eligibility, Docs & EMI Check","description":"Personal loan eligibility in India: income proof, FOIR, CIBIL, documents banks ask, and EMI stress-tests before you apply — educational, not a lender offer.","url":"https://contentverse.co.in/guides/money/personal-loan-eligibility-documents-india","dateModified":"Oct 2026","author":{"@type":"Organization","name":"ContentVerse India","url":"https://contentverse.co.in"},"publisher":{"@type":"Organization","name":"ContentVerse India","url":"https://contentverse.co.in"},"articleSection":"Money","inLanguage":"en-IN","keywords":"personal loan eligibility india, personal loan documents salaried, personal loan cibil score, foir personal loan, personal loan emi calculator, personal loan kfs india","wordCount":646,"mainEntityOfPage":"https://contentverse.co.in/guides/money/personal-loan-eligibility-documents-india","isPartOf":{"@type":"WebPage","name":"Money Guides — EMI, SIP, IFSC, Tax & GST","url":"https://contentverse.co.in/guides/money"}}17:["$","article",null,{"className":"container py-8 md:py-10","children":[[["$","script","0",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$21"}}],["$","script","1",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"India Guides\",\"item\":\"https://contentverse.co.in/guides\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Money\",\"item\":\"https://contentverse.co.in/guides/money\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"Personal loan checklist\",\"item\":\"https://contentverse.co.in/guides/money/personal-loan-eligibility-documents-india\"}]}"}}],["$","script","2",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"FAQPage\",\"mainEntity\":[{\"@type\":\"Question\",\"name\":\"What FOIR means?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Fixed Obligation to Income Ratio — how much of income already goes to EMIs/obligations. Lenders set their own caps. Not a public universal number.\"}},{\"@type\":\"Question\",\"name\":\"Prepayment allowed?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Often yes after a lock-in, sometimes with a fee. Read the sanction letter; do not rely on sales chat screenshots.\"}},{\"@type\":\"Question\",\"name\":\"Is this a loan offer?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"No. ContentVerse India is not a lender here.\"}},{\"@type\":\"Question\",\"name\":\"How many months of statements?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Commonly 3–6 months for salaried; self-employed packs are longer. Follow the checklist in the lender’s application, not a blog screenshot.\"}}]}"}}]],["$","div",null,{"className":"flex items-start justify-center gap-6 lg:gap-8","children":[["$","div",null,{"className":"min-w-0 w-full max-w-3xl space-y-8","children":[["$","div",null,{"className":"space-y-3","children":[["$","$L8",null,{"href":"/guides/money","className":"group inline-flex items-center gap-2 text-sm font-medium transition-colors text-muted-foreground hover:text-foreground","children":[["$","span",null,{"className":"inline-flex h-8 w-8 items-center justify-center rounded-full border transition-colors border-border/70 bg-card/70 group-hover:border-foreground/20 group-hover:bg-card","children":["$","svg",null,{"ref":"$undefined","xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left h-3.5 w-3.5","aria-hidden":true,"children":["$L22","$L23","$undefined"]}]}],"$L24"]}],"$L25"]}],"$L26","$L27","$L28","$L29","$L2a","$L2b","$L2c","$L2d","$L2e","$L2f"]}],"$L30"]}]]}]
