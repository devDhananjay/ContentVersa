14:T820,{"@context":"https://schema.org","@type":"CollectionPage","name":"India Guides — Trending, Schemes, Money, Jobs, Cricket, AI & Movies","description":"Free India explainers: FASTag, EMI, SIP, tax, schemes, jobs, cricket, AI, and OTT — plus 30 high-intent topic guides built for search.","url":"https://contentverse.co.in/guides","isPartOf":{"@type":"WebSite","name":"ContentVerse India","url":"https://contentverse.co.in"},"hasPart":[{"@type":"WebPage","name":"Trending","url":"https://contentverse.co.in/guides/trending","description":"Clear explainers on why topics spike on Google Trends, social media, and news in India — context, timeline, and what to watch next."},{"@type":"WebPage","name":"Cricket","url":"https://contentverse.co.in/guides/cricket","description":"How to follow India cricket match days: key moments, scorecard reading, and where to get live updates on ContentVerse India Sports."},{"@type":"WebPage","name":"Govt Schemes","url":"https://contentverse.co.in/guides/schemes","description":"India government scheme explainers: who is eligible, documents needed, and how to apply on official portals — with clear disclaimers."},{"@type":"WebPage","name":"Job Alerts","url":"https://contentverse.co.in/guides/jobs","description":"How to read sarkari and private job notifications: eligibility, pay scale, last date, and official apply links."},{"@type":"WebPage","name":"AI Tools","url":"https://contentverse.co.in/guides/ai-tools","description":"Practical how-tos for popular AI tools — setup, prompts, privacy tips, and use-cases for students and creators in India."},{"@type":"WebPage","name":"Movies / OTT","url":"https://contentverse.co.in/guides/movies","description":"India OTT and cinema guides: release dates, cast, and where to watch legally on Netflix, Prime, JioCinema, and more."},{"@type":"WebPage","name":"Money","url":"https://contentverse.co.in/guides/money","description":"Practical India money explainers: EMI and SIP maths, IFSC transfers, salary tax reg