6:["$","article",null,{"className":"mx-auto max-w-3xl space-y-8","children":[[["$","script","0",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"WebPage\",\"name\":\"Loans India — EMI, Home & Personal Loan Basics\",\"description\":\"Understand loan EMIs in India for home, car and personal loans. Plan repayments with a free EMI calculator.\",\"url\":\"https://contentverse.co.in/finance/loans\",\"isPartOf\":{\"@type\":\"WebSite\",\"name\":\"ContentVerse India\",\"url\":\"https://contentverse.co.in\"}}"}}],["$","script","1",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"FAQPage\",\"mainEntity\":[{\"@type\":\"Question\",\"name\":\"How is EMI calculated?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"EMI depends on principal, annual interest rate, and tenure in months. Our EMI calculator shows monthly payment, total interest, and total amount payable.\"}},{\"@type\":\"Question\",\"name\":\"What documents do banks ask for loans?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Typically KYC, income proofs (salary slips/ITR), bank statements and property papers for home loans. Exact lists vary by lender and product.\"}},{\"@type\":\"Question\",\"name\":\"Should I prepay my loan?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Prepaying can cut interest if fees are low and you keep an emergency fund. Run EMI maths before deciding.\"}}]}"}}],["$","script","2",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https://contentverse.co.in\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Finance\",\"item\":\"https://contentverse.co.in/finance\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"Loans\",\"item\":\"https://contentverse.co.in/finance/loans\"}