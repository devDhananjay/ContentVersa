6:["$","article",null,{"className":"mx-auto max-w-3xl space-y-8","children":[[["$","script","0",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"WebPage\",\"name\":\"Stocks India — Nifty, Sensex & Share Basics\",\"description\":\"Learn stock market basics in India, follow Nifty and Sensex on the Finance Hub, and understand risk before you invest.\",\"url\":\"https://contentverse.co.in/finance/stocks\",\"isPartOf\":{\"@type\":\"WebSite\",\"name\":\"ContentVerse India\",\"url\":\"https://contentverse.co.in\"}}"}}],["$","script","1",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"FAQPage\",\"mainEntity\":[{\"@type\":\"Question\",\"name\":\"Is the Finance Hub investment advice?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"No. Market data and charts are informational. Decisions should follow your own research or a SEBI-registered advisor.\"}},{\"@type\":\"Question\",\"name\":\"Do I need a demat account to buy stocks?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Yes. Retail investors in India typically need a demat and trading account with a registered broker to hold and trade shares.\"}},{\"@type\":\"Question\",\"name\":\"What are Nifty and Sensex?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"They are major Indian stock indices tracking baskets of large companies — useful market mood indicators, not individual stock advice.\"}}]}"}}],["$","script","2",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https://contentverse.co.in\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Finance\",\"item\":\"https://contentverse.co.in/finance\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"Stocks\",\"item\":\"https://contentverse.co.in/finance/sto