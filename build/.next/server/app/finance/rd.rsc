1c:["$","article",null,{"className":"mx-auto max-w-3xl space-y-8","children":[[["$","script","0",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"WebPage\",\"name\":\"Recurring Deposit (RD) India — Monthly Savings Plan\",\"description\":\"Learn how recurring deposits work in India and estimate RD maturity with a free calculator for monthly savings.\",\"url\":\"https://contentverse.co.in/finance/rd\",\"isPartOf\":{\"@type\":\"WebSite\",\"name\":\"ContentVerse India\",\"url\":\"https://contentverse.co.in\"}}"}}],["$","script","1",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"FAQPage\",\"mainEntity\":[{\"@type\":\"Question\",\"name\":\"RD or SIP — which should I choose?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Use RD for near-term goals needing stability. Use equity SIPs for long-term goals where you can tolerate market ups and downs.\"}},{\"@type\":\"Question\",\"name\":\"Can I miss an RD installment?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Policies vary by bank. Some allow delayed deposits with penalties; repeated misses can close the RD. Read your deposit terms.\"}},{\"@type\":\"Question\",\"name\":\"Is post office RD different from bank RD?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Both are recurring deposits with different rate schedules and rules. Compare tenure, interest and premature closure terms before choosing.\"}}]}"}}],["$","script","2",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https://contentverse.co.in\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Finance\",\"item\":\"https://contentverse.co.in/finance\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"RD\",\"item\":\"https://contentverse.co.in/f