12:["$","article",null,{"className":"mx-auto max-w-3xl space-y-8","children":[[["$","script","0",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"WebPage\",\"name\":\"Silver Price Today India — Rate per Gram & Kg\",\"description\":\"Check today's silver price in India per gram, 10g and kg. Estimate weight-based cost with ContentVerse India silver tools.\",\"url\":\"https://contentverse.co.in/finance/silver-price-today\",\"isPartOf\":{\"@type\":\"WebSite\",\"name\":\"ContentVerse India\",\"url\":\"https://contentverse.co.in\"}}"}}],["$","script","1",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"FAQPage\",\"mainEntity\":[{\"@type\":\"Question\",\"name\":\"How is silver price calculated in India?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Dealers typically start from a spot-linked rate, then adjust for purity, making charges, and taxes. Online tools give an estimate — the invoice rate can differ.\"}},{\"@type\":\"Question\",\"name\":\"Is online silver rate the same as local market?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Online tools give an estimate. Local dealers set final rates with purity, making charges and taxes — always confirm before buying.\"}},{\"@type\":\"Question\",\"name\":\"Should I buy silver jewellery or bars?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Jewellery includes making charges; bars/coins are closer to metal value. Choose based on use (wear vs store-of-value) and liquidity needs.\"}}]}"}}],["$","script","2",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https://contentverse.co.in\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Finance\",\"item\":\"https://contentverse.co.in/finance\"},{\"@type\":\"