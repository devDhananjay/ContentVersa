6:["$","article",null,{"className":"mx-auto max-w-3xl space-y-8","children":[[["$","script","0",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"WebPage\",\"name\":\"SIP in India — Systematic Investment Plans Explained\",\"description\":\"Learn how SIP mutual fund investing works in India, estimate returns with a free SIP calculator, and plan long-term wealth.\",\"url\":\"https://contentverse.co.in/finance/sip\",\"isPartOf\":{\"@type\":\"WebSite\",\"name\":\"ContentVerse India\",\"url\":\"https://contentverse.co.in\"}}"}}],["$","script","1",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"FAQPage\",\"mainEntity\":[{\"@type\":\"Question\",\"name\":\"What is a good SIP amount for beginners?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Start with an amount you can continue every month without stress — even ₹500–₹1,000 builds the habit. Increase when cash flow allows.\"}},{\"@type\":\"Question\",\"name\":\"Are SIP returns guaranteed?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"No. Mutual fund SIPs are market-linked. Calculators show illustrative returns based on assumed rates, not promises.\"}},{\"@type\":\"Question\",\"name\":\"Can I stop a SIP anytime?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Most SIPs can be paused or cancelled via your AMC/broker app. Stopping contributions does not force you to redeem existing units.\"}}]}"}}],["$","script","2",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https://contentverse.co.in\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Finance\",\"item\":\"https://contentverse.co.in/finance\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"SIP\",\"item\":\"https://contentverse.co.in/finance/sip\"}]}"}}]],["$","header",null,{"className":"space-y-3","children":[["$","p",null,{"className":"inline-flex items-center gap-1.5 text-xs font-bold uppercase tracking-wider text-emerald-300","children":[["$","svg",null,{"ref":"$undefined","xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-wallet h-3.5 w-3.5","children":[["$","path","18etb6",{"d":"M19 7V4a1 1 0 0 0-1-1H5a2 2 0 0 0 0 4h15a1 1 0 0 1 1 1v4h-3a2 2 0 0 0 0 4h3a1 1 0 0 0 1-1v-2a1 1 0 0 0-1-1"}],["$","path","xoc0q4",{"d":"M3 5v14a2 2 0 0 0 2 2h15a1 1 0 0 0 1-1v-4"}],"$undefined"]}],"MoneyVerse · ","Investing · Mutual Funds"]}],["$","h1",null,{"className":"font-display text-3xl font-bold tracking-tight md:text-4xl","children":"SIP — Systematic Investment Plan India"}],["$","p",null,{"className":"text-sm leading-relaxed text-muted-foreground md:text-base","children":"Learn how SIP mutual fund investing works in India, estimate returns with a free SIP calculator, and plan long-term wealth."}]]}],["$","div",null,{"className":"space-y-4 text-sm leading-relaxed text-muted-foreground md:text-[15px]","children":[["$","p","A SIP lets you invest a fixed amount regularly i",{"children":"A SIP lets you invest a fixed amount regularly in mutual funds. It encourages discipline, rupee-cost averaging, and long-term compounding — popular among Indian salaried investors."}],["$","p","Use our SIP calculator to model monthly investme",{"children":"Use our SIP calculator to model monthly investment, tenure, and expected return assumptions. Past returns are not guarantees."}]]}],["$","ul",null,{"className":"space-y-2 rounded-2xl border border-emerald-500/20 bg-emerald-500/5 p-5 text-sm","children":["$L11","$L12","$L13","$L14"]}],"$L15","$L16","$L17","$L18","$L19","$L1a","$L1b","$L1c"]}]
