6:["$","article",null,{"className":"mx-auto max-w-3xl space-y-8","children":[[["$","script","0",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"WebPage\",\"name\":\"Gold Price Today India — 22K & 24K Rates\",\"description\":\"Check today's gold price in India for 22K and 24K, understand making charges, and verify BIS HUID before you buy jewellery.\",\"url\":\"https://contentverse.co.in/finance/gold-price-today\",\"isPartOf\":{\"@type\":\"WebSite\",\"name\":\"ContentVerse India\",\"url\":\"https://contentverse.co.in\"}}"}}],["$","script","1",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"FAQPage\",\"mainEntity\":[{\"@type\":\"Question\",\"name\":\"Where can I check gold price today in India?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"ContentVerse India GoldVerse and finance guides summarise gold rate context for India. Always confirm the final invoice rate with your jeweller, including making charges and GST.\"}},{\"@type\":\"Question\",\"name\":\"Is 22K or 24K better for jewellery?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"22K (916) is common for wearable jewellery in India. 24K (999) is purer and often used for coins and bars; it is softer for daily wear.\"}},{\"@type\":\"Question\",\"name\":\"Why does jeweller gold price differ from online rates?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Online rates are often spot-linked references. Retail bills add making charges, wastage and GST, so the invoice per-gram rate is usually higher.\"}}]}"}}],["$","script","2",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https://contentverse.co.in\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Finance\",\"item\":\"https://contentverse.