15:["$","script","1",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"FAQPage\",\"mainEntity\":[{\"@type\":\"Question\",\"name\":\"Are India Tools on ContentVerse India free?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Yes. Weather, tax, PDF, IFSC, EMI, SIP, PNR helpers and more are free to use. Some advanced MoneyVerse AI tools need sign-in.\"}},{\"@type\":\"Question\",\"name\":\"Is this an official government website?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"No. ContentVerse India is independent. For RC, challan or DL records use official Parivahan/Vahan portals.\"}},{\"@type\":\"Question\",\"name\":\"Do PDF tools upload my files?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Merge, split and compress PDF tools run in your browser. Files stay on your device and are not uploaded to our servers.\"}},{\"@type\":\"Question\",\"name\":\"Which tax year does the salary calculator use?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"The salary tax calculator targets current FY slab estimates for planning. Always verify on the Income Tax e-filing portal before filing.\"}}]}"}}]
