20:T922,{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"Can I extract non-continuous pages like 1, 3 and 7?","acceptedAnswer":{"@type":"Answer","text":"The tool extracts one continuous range at a time. Run it once for each page or range and merge the results if needed."}},{"@type":"Question","name":"Is my PDF uploaded to a server?","acceptedAnswer":{"@type":"Answer","text":"No. It is processed in your browser and stays on your device."}},{"@type":"Question","name":"What is the maximum file size?","acceptedAnswer":{"@type":"Answer","text":"25 MB per file. Compress or split very large files before using the tool."}},{"@type":"Question","name":"Does splitting change the page quality?","acceptedAnswer":{"@type":"Answer","text":"No. Pages are copied as they are, so the quality is unchanged."}},{"@type":"Question","name":"Why does the page range not match the numbers printed on the pages?","acceptedAnswer":{"@type":"Answer","text":"The tool counts pages by their position in the file, so a cover page or index shifts the numbering. Use the page counter in your PDF viewer to pick the range."}},{"@type":"Question","name":"Can I split a password-protected PDF?","acceptedAnswer":{"@type":"Answer","text":"Remove the password in the original software first. A protected or damaged file may fail to open in the tool."}},{"@type":"Question","name":"Can I use it on my phone?","acceptedAnswer":{"@type":"Answer","text":"Yes. It runs in a modern mobile browser. For very large files a laptop is more comfortable, because the work is done on your device’s own memory."}},{"@type":"Question","name":"Are my PDF files uploaded to ContentVerse India?","acceptedAnswer":{"@type":"Answer","text":"No. PDF tools run entirely in your browser. Files stay on your device and are not sent to our servers."}},{"@type":"Question","name":"Is the Split PDF free on ContentVerse India?","acceptedAnswer":{"@type":"Answer","text":"Yes. All India utility tools on ContentVerse India are free to use with no sign-up required."}},{"@type":"Question","name":"Is this an official government website?","acceptedAnswer":{"@type":"Answer","text":"No. ContentVerse India is an independent platform. We use public datasets and open APIs. For official records, use government portals like Parivahan, GST, FoSCoS, or ECI."}}]}16:[[["$","script","0",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"WebApplication\",\"name\":\"Split PDF\",\"alternateName\":\"Split PDF Online Free — Extract Pages India\",\"description\":\"Extract a page range from any PDF into a new file. Runs in your browser — nothing uploaded to our servers.\",\"url\":\"https://contentverse.co.in/tools/split-pdf\",\"applicationCategory\":\"UtilitiesApplication\",\"operatingSystem\":\"Any\",\"browserRequirements\":\"Requires JavaScript\",\"offers\":{\"@type\":\"Offer\",\"price\":\"0\",\"priceCurrency\":\"INR\"},\"provider\":{\"@type\":\"Organization\",\"name\":\"ContentVerse India\",\"url\":\"https://contentverse.co.in\"},\"inLanguage\":\"en-IN\",\"featureList\":\"How to extract pages from a PDF, Privacy of your document, When splitting helps, Printed page numbers versus PDF page numbers, Documents people commonly split, A simple workflow with the other PDF tools\"}"}}],["$","script","1",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$20"}}],"$L21","$L22"],"$L23"]
