26:["$","div","How to find an IFSC code step by step",{"className":"space-y-3","children":[["$","h3",null,{"className":"font-display text-lg font-semibold","children":"How to find an IFSC code step by step"}],[["$","p","Type the 11-character IFSC into the box and pres",{"className":"text-sm leading-relaxed text-muted-foreground md:text-base","children":"Type the 11-character IFSC into the box and press “Find branch”. The tool shows the bank, branch, district and state it belongs to. Check that they match your passbook, cheque book or the beneficiary’s details. If you do not have the code, find it on a cheque leaf, in your net-banking profile or on the bank’s official branch locator, then paste it here to verify."}],["$","p","For large payments, confirm the IFSC from a seco",{"className":"text-sm leading-relaxed text-muted-foreground md:text-base","children":"For large payments, confirm the IFSC from a second trusted source, such as the bank’s SMS, the printed cheque or the bank’s official website. A quick check takes seconds and avoids a failed transfer."}]],["$","ul",null,{"className":"list-disc space-y-1.5 pl-5 text-sm text-muted-foreground","children":[["$","li","Enter the 11-character IFSC and press Find branch",{"children":"Enter the 11-character IFSC and press Find branch"}],["$","li","Compare the bank, branch, district and state with your records",{"children":"Compare the bank, branch, district and state with your records"}],["$","li","Compare the result with your cheque book or passbook before you pay",{"children":"Compare the result with your cheque book or passbook before you pay"}]]}],["$","div",null,{"className":"flex justify-center py-2","children":["$","aside",null,{"aria-label":"Advertisement","data-cv-ad-zone":"mrec","className":"mx-auto flex w-fit max-w-full flex-col items-center","children":[["$","p",null,{"className":"mb-1.5 text-center text-[9px] font-medium uppercase tracking-[0.14em] text-muted-foreground/70","children":"Ad"}],["$","$L31",null,