20:T938,{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"Is the Indian Holidays free on ContentVerse India?","acceptedAnswer":{"@type":"Answer","text":"Yes. All India utility tools on ContentVerse India are free to use with no sign-up required."}},{"@type":"Question","name":"Is this an official government website?","acceptedAnswer":{"@type":"Answer","text":"No. ContentVerse India is an independent platform. We use public datasets and open APIs. For official records, use government portals like Parivahan, GST, FoSCoS, or ECI."}},{"@type":"Question","name":"Which holidays are national holidays in India?","acceptedAnswer":{"@type":"Answer","text":"Republic Day (26 January), Independence Day (15 August) and Gandhi Jayanti (2 October) are observed across the country."}},{"@type":"Question","name":"Are the dates the same in every state?","acceptedAnswer":{"@type":"Answer","text":"Central holidays are the same, but states add their own regional holidays. Check your state’s list for exact dates."}},{"@type":"Question","name":"Why do festival dates change every year?","acceptedAnswer":{"@type":"Answer","text":"Many festivals follow the lunar calendar, so their dates on the Gregorian calendar shift from year to year."}},{"@type":"Question","name":"Are banks open on all holidays?","acceptedAnswer":{"@type":"Answer","text":"No. Bank branches close on holidays notified in the RBI calendar for the state, and on Sundays and the second and fourth Saturdays. Digital services usually work throughout."}},{"@type":"Question","name":"Does the list include state and bank holidays?","acceptedAnswer":{"@type":"Answer","text":"The page shows central government holidays. State holidays and RBI bank holidays differ by state, so check your state notification or the RBI list for exact closures."}},{"@type":"Question","name":"Do Diwali and Holi fall on the same date every year?","acceptedAnswer":{"@type":"Answer","text":"No. They follow the lunisolar calendar, so the date moves each year. Fixed holidays such as Republic Day and Independence Day stay on the same dates."}},{"@type":"Question","name":"How can I find next year’s holidays?","acceptedAnswer":{"@type":"Answer","text":"Press the next-year button on the page to see its list. Dates for moon-based festivals may be confirmed later by the government."}}]}16:[[["$","script","0",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"WebApplication\",\"name\":\"Indian Holidays\",\"description\":\"View public holidays in India for the current and next year — Republic Day, Diwali window references, and national holidays list.\",\"url\":\"https://contentverse.co.in/tools/indian-holidays\",\"applicationCategory\":\"UtilitiesApplication\",\"operatingSystem\":\"Web\",\"offers\":{\"@type\":\"Offer\",\"price\":\"0\",\"priceCurrency\":\"INR\"},\"provider\":{\"@type\":\"Organization\",\"name\":\"ContentVerse India\",\"url\":\"https://contentverse.co.in\"}}"}}],["$","script","1",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$20"}}],["$","script","2",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https://contentverse.co.in\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"India Tools\",\"item\":\"https://contentverse.co.in/tools\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"Indian Holidays\",\"item\":\"https://contentverse.co.in/tools/indian-holidays\"}]}"}}]],"$L21"]
