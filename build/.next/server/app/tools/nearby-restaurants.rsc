21:T912,{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"Does the tool show menus or ratings?","acceptedAnswer":{"@type":"Answer","text":"It shows names and addresses from map data. For menus, ratings and offers use the restaurant’s own page or an app."}},{"@type":"Question","name":"How can I check whether a restaurant is licensed?","acceptedAnswer":{"@type":"Answer","text":"Look for the FSSAI number on the premises or bill and verify it on the official FoSCoS portal."}},{"@type":"Question","name":"Can I use it to find vegetarian or pure-veg restaurants?","acceptedAnswer":{"@type":"Answer","text":"The list shows restaurants of all kinds. Search the area, then call the shortlisted places or check their own pages to confirm that they are vegetarian and how the food is prepared."}},{"@type":"Question","name":"What radius should I choose?","acceptedAnswer":{"@type":"Answer","text":"Use 1 to 3 km in busy city areas, 5 km in smaller towns and 10 km or more on highways or in rural areas where eateries are far apart."}},{"@type":"Question","name":"Is the service charge compulsory?","acceptedAnswer":{"@type":"Answer","text":"No. A service charge is voluntary. If it was not clearly displayed before you ordered, you can ask the restaurant to remove it from the bill."}},{"@type":"Question","name":"Why are some places missing from the results?","acceptedAnswer":{"@type":"Answer","text":"The data comes from map sources that may not list every business, and small or new places can be missing. Try a larger radius or a nearby landmark as the search area."}},{"@type":"Question","name":"Why do nearby results need location permission?","acceptedAnswer":{"@type":"Answer","text":"Near me uses your browser GPS. City search uses geocoding instead — no GPS needed."}},{"@type":"Question","name":"Is the Nearby Restaurants free on ContentVerse India?","acceptedAnswer":{"@type":"Answer","text":"Yes. All India utility tools on ContentVerse India are free to use with no sign-up required."}},{"@type":"Question","name":"Is this an official government website?","acceptedAnswer":{"@type":"Answer","text":"No. ContentVerse India is an independent platform. We use public datasets and open APIs. For official records, use government portals like Parivahan, GST, FoSCoS, or ECI."}}]}17:[[["$","script","0",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"WebApplication\",\"name\":\"Nearby Restaurants\",\"alternateName\":\"Nearby Restaurants Finder India\",\"description\":\"Discover restaurants and cafes near you or around any city in India.\",\"url\":\"https://contentverse.co.in/tools/nearby-restaurants\",\"applicationCategory\":\"UtilitiesApplication\",\"operatingSystem\":\"Any\",\"browserRequirements\":\"Requires JavaScript\",\"offers\":{\"@type\":\"Offer\",\"price\":\"0\",\"priceCurrency\":\"INR\"},\"provider\":{\"@type\":\"Organization\",\"name\":\"ContentVerse India\",\"url\":\"https://contentverse.co.in\"},\"inLanguage\":\"en-IN\",\"featureList\":\"How to find restaurants near you, Choosing a good place to eat, Food safety and hygiene basics, Finding the right kind of restaurant, Eating out with dietary needs, Ordering, paying and tipping\"}"}}],["$","script","1",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$21"}}],"$L22","$L23"],"$L24"]
