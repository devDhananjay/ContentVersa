2b:["$","div","When to use UUIDs",{"className":"space-y-3","children":[["$","h3",null,{"className":"font-display text-lg font-semibold","children":"When to use UUIDs"}],[["$","p","UUIDs suit distributed systems where several ser",{"className":"text-sm leading-relaxed text-muted-foreground md:text-base","children":"UUIDs suit distributed systems where several servers or devices create records at the same time, public URLs where sequential numbers would reveal how many records exist, and offline apps that sync later. They avoid the need for a central counter."}],["$","p","They have drawbacks: they are longer than intege",{"className":"text-sm leading-relaxed text-muted-foreground md:text-base","children":"They have drawbacks: they are longer than integers, take more index space, and random UUIDs can fragment database indexes. Time-ordered identifiers such as UUID v7 or ULIDs solve the index problem where it matters. For most small projects v4 is fine."}]],["$","ul",null,{"className":"list-disc space-y-1.5 pl-5 text-sm text-muted-foreground","children":[["$","li","Do not treat a UUID as a secret; use proper tokens for authentication",{"children":"Do not treat a UUID as a secret; use proper tokens for authentication"}],["$","li","Store UUIDs in a native UUID or binary column where your database supports it",{"children":"Store UUIDs in a native UUID or binary column where your database supports it"}],["$","li","Avoid using UUIDs as human-readable codes",{"children":"Avoid using UUIDs as human-readable codes"}]]}],null]}]
2c:["$","div","Testing and development tips",{"className":"space-y-3","children":[["$","h3",null,{"className":"font-display text-lg font-semibold","children":"Testing and development tips"}],[["$","p","Use batches of UUIDs to seed test databases, moc",{"className":"text-sm leading-relaxed text-muted-foreground md:text-base","children":"Use batches of UUIDs to seed test databases, mock API responses or create unique file names for uploads. If you need predictable values for tests, generate them once and commit them to the fixture rather than regenerating each run."}]],null,null]}]
