2c:["$","div","Latitude and longitude in plain words",{"className":"space-y-3","children":[["$","h3",null,{"className":"font-display text-lg font-semibold","children":"Latitude and longitude in plain words"}],[["$","p","Latitude measures how far north or south of the ",{"className":"text-sm leading-relaxed text-muted-foreground md:text-base","children":"Latitude measures how far north or south of the equator a place is, from 0° to 90°. Longitude measures how far east or west of the prime meridian it is, from 0° to 180°. India lies roughly between 8° and 37° north and 68° and 97° east, so Indian coordinates are usually positive numbers such as 28.6139° N, 77.2090° E for Delhi."}],["$","p","Decimal degrees with four decimal places point t",{"className":"text-sm leading-relaxed text-muted-foreground md:text-base","children":"Decimal degrees with four decimal places point to within about 11 metres, and six decimal places to within about 11 centimetres, so more digits make the position more precise."}]],null,null]}]
2d:["$","div","Accuracy and privacy",{"className":"space-y-3","children":[["$","h3",null,{"className":"font-display text-lg font-semibold","children":"Accuracy and privacy"}],[["$","p","Position accuracy depends on your device. A phon",{"className":"text-sm leading-relaxed text-muted-foreground md:text-base","children":"Position accuracy depends on your device. A phone with GPS outdoors can be accurate to a few metres, while a laptop that uses Wi-Fi location may be off by hundreds of metres. Dense buildings and indoor spaces can reduce accuracy."}],["$","p","Your coordinates are used only to display the re",{"className":"text-sm leading-relaxed text-muted-foreground md:text-base","children":"Your coordinates are used only to display the result in your browser and to fetch the address. Do not share exact coordinates publicly if you do not want people to find your home."}]],["$","ul",null,{"className":"list-disc space-y-1.5 pl-5 text-sm text-muted-foreground","children":[["$","li","Switch on device location and step outdoors for the best GPS fix",{"children":"Switch on device location and step outdoors for the best GPS fix"}],["$","li","Share your live location only with people you trust",{"children":"Share your live location only with people you trust"}],["$","li","Remove location data from photos before posting them publicly",{"children":"Remove location data from photos before posting them publicly"}]]}],null]}]
