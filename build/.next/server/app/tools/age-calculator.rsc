2d:["$","div","How the calculation works",{"className":"space-y-3","children":[["$","h3",null,{"className":"font-display text-lg font-semibold","children":"How the calculation works"}],[["$","p","The calculator subtracts the birth date from the",{"className":"text-sm leading-relaxed text-muted-foreground md:text-base","children":"The calculator subtracts the birth date from the reference date field by field. It counts completed years first, then the remaining months, then the remaining days, borrowing from the previous month when needed, using the real number of days in that month. Leap years, including 29 February birthdays, are handled by the calendar."}],["$","p","If your birthday has not yet occurred in the ref",{"className":"text-sm leading-relaxed text-muted-foreground md:text-base","children":"If your birthday has not yet occurred in the reference year, the year count is one less. That is why a person born on 31 December is still a year younger than a person born on 1 January of the same year until the end of December."}]],null,null]}]
2e:["$","div","Where age cut-offs matter in India",{"className":"space-y-3","children":[["$","h3",null,{"className":"font-display text-lg font-semibold","children":"Where age cut-offs matter in India"}],[["$","p","Competitive exams and public-sector recruitment ",{"className":"text-sm leading-relaxed text-muted-foreground md:text-base","children":"Competitive exams and public-sector recruitment fix a minimum and maximum age and often give relaxations for reserved categories, ex-servicemen or persons with disabilities. School admissions use a cut-off date such as 31 March for a given class. Insurance and pension products use age at the nearest or last birthday, which can change the premium."}],["$","p","Always read the notification carefully: some use",{"className":"text-sm leading-relaxed text-muted-foreground md:text-base","children":"Always read the notification carefully: some use “age as on” the closing date and some use the first day of a month or year. A difference of a single day can decide eligibility, so calculate against the exact date given."}]],["$","ul",null,{"className":"list-disc space-y-1.5 pl-5 text-sm text-muted-foreground","children":[["$","li","Check the exact reference date in the official notification",{"children":"Check the exact reference date in the official notification"}],["$","li","Keep a copy of your birth certificate or Class 10 certificate for proof",{"children":"Keep a copy of your birth certificate or Class 10 certificate for proof"}],["$","li","Category-based age relaxation is declared in the notification, not by this tool",{"children":"Category-based age relaxation is declared in the notification, not by this tool"}]]}],null]}]
