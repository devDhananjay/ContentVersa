20:T79e,{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"What is the PPF lock-in period?","acceptedAnswer":{"@type":"Answer","text":"The basic lock-in is 15 financial years. Partial withdrawal is allowed from the seventh year, and you can extend the account in blocks of five years after maturity."}},{"@type":"Question","name":"Is PPF interest tax-free?","acceptedAnswer":{"@type":"Answer","text":"Yes. Interest earned in a PPF account and the maturity amount are exempt from income tax. The Section 80C deduction on contributions is available only under the old tax regime."}},{"@type":"Question","name":"How often does the PPF interest rate change?","acceptedAnswer":{"@type":"Answer","text":"The government announces the PPF rate every quarter. The rate applied to your balance can therefore change during the 15-year term."}},{"@type":"Question","name":"What is the maximum I can invest in PPF in a year?","acceptedAnswer":{"@type":"Answer","text":"₹1,50,000 per financial year across all your contributions. Amounts above this limit do not earn interest."}},{"@type":"Question","name":"Why does my passbook balance differ from this estimate?","acceptedAnswer":{"@type":"Answer","text":"The real PPF calculates interest monthly on the lowest balance between the 5th and the last day of the month and credits it annually. This tool uses a simpler yearly compounding, so small differences are normal."}},{"@type":"Question","name":"Is the PPF Calculator free on ContentVerse India?","acceptedAnswer":{"@type":"Answer","text":"Yes. All India utility tools on ContentVerse India are free to use with no sign-up required."}},{"@type":"Question","name":"Is this an official government website?","acceptedAnswer":{"@type":"Answer","text":"No. ContentVerse India is an independent platform. We use public datasets and open APIs. For official records, use government portals like Parivahan, GST, FoSCoS, or ECI."}}]}16:[[["$","script","0",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"WebApplication\",\"name\":\"PPF Calculator\",\"alternateName\":\"PPF Calculator — Public Provident Fund India\",\"description\":\"Plan PPF corpus with yearly deposits and compound interest. Free Public Provident Fund calculator India.\",\"url\":\"https://contentverse.co.in/tools/ppf-calculator\",\"applicationCategory\":\"UtilitiesApplication\",\"operatingSystem\":\"Any\",\"browserRequirements\":\"Requires JavaScript\",\"offers\":{\"@type\":\"Offer\",\"price\":\"0\",\"priceCurrency\":\"INR\"},\"provider\":{\"@type\":\"Organization\",\"name\":\"ContentVerse India\",\"url\":\"https://contentverse.co.in\"},\"inLanguage\":\"en-IN\",\"featureList\":\"How to use the PPF calculator, Why PPF is popular with Indian savers, How the maturity amount is calculated, Extending PPF beyond 15 years\"}"}}],["$","script","1",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$20"}}],["$","script","2",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https://contentverse.co.in\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"India Tools\",\"item\":\"https://contentverse.co.in/tools\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"PPF Calculator\",\"item\":\"https://contentverse.co.in/tools/ppf-calculator\"}]}"}}],"$L21"],"$L22"]
