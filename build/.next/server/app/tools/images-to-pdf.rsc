20:T983,{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"Is the Images to PDF free on ContentVerse India?","acceptedAnswer":{"@type":"Answer","text":"Yes. All India utility tools on ContentVerse India are free to use with no sign-up required."}},{"@type":"Question","name":"Is this an official government website?","acceptedAnswer":{"@type":"Answer","text":"No. ContentVerse India is an independent platform. We use public datasets and open APIs. For official records, use government portals like Parivahan, GST, FoSCoS, or ECI."}},{"@type":"Question","name":"Are my PDF files uploaded to ContentVerse India?","acceptedAnswer":{"@type":"Answer","text":"No. PDF tools run entirely in your browser. Files stay on your device and are not sent to our servers."}},{"@type":"Question","name":"What is the maximum file size?","acceptedAnswer":{"@type":"Answer","text":"Each file can be up to 25 MB. Very large or encrypted PDFs may fail — unlock or compress offline first if needed."}},{"@type":"Question","name":"Which image formats are supported?","acceptedAnswer":{"@type":"Answer","text":"JPG and PNG images are supported."}},{"@type":"Question","name":"Can I choose the order of pages?","acceptedAnswer":{"@type":"Answer","text":"Yes. The order of the images you add is the order of the pages in the PDF."}},{"@type":"Question","name":"Are my images uploaded?","acceptedAnswer":{"@type":"Answer","text":"No. The conversion happens in your browser and the images stay on your device."}},{"@type":"Question","name":"Why is my PDF so large?","acceptedAnswer":{"@type":"Answer","text":"Phone photos are large. Crop and resize images before converting, or compress the finished PDF."}},{"@type":"Question","name":"Why does my iPhone photo not work?","acceptedAnswer":{"@type":"Answer","text":"iPhones may save pictures as HEIC. Export the photo as JPG, or set the camera format to “Most Compatible”, because the tool accepts only JPG and PNG."}},{"@type":"Question","name":"How can I fix a wrong page order?","acceptedAnswer":{"@type":"Answer","text":"Clear the list and add the images again in the correct order, because the order of adding is the page order."}},{"@type":"Question","name":"Can I convert a photo of a document that is sideways?","acceptedAnswer":{"@type":"Answer","text":"Rotate the image in your gallery or editing app first and then add it, so the page is upright in the PDF."}}]}16:[[["$","script","0",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"WebApplication\",\"name\":\"Images to PDF\",\"description\":\"Convert JPG or PNG images into a single PDF. Free browser tool — no upload required.\",\"url\":\"https://contentverse.co.in/tools/images-to-pdf\",\"applicationCategory\":\"UtilitiesApplication\",\"operatingSystem\":\"Web\",\"offers\":{\"@type\":\"Offer\",\"price\":\"0\",\"priceCurrency\":\"INR\"},\"provider\":{\"@type\":\"Organization\",\"name\":\"ContentVerse India\",\"url\":\"https://contentverse.co.in\"}}"}}],["$","script","1",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$20"}}],["$","script","2",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https://contentverse.co.in\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"India Tools\",\"item\":\"https://contentverse.co.in/tools\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"Images to PDF\",\"item\":\"https://contentverse.co.in/tools/images-to-pdf\"}]}"}}]],"$L21"]
