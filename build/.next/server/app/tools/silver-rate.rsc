2a:["$","p",null,{"className":"text-sm leading-relaxed text-muted-foreground md:text-base","children":"Silver is bought as jewellery, coins, bars and as an industrial metal, and its price in India changes every day with global silver rates and the dollar–rupee exchange rate. This tool shows a spot-based estimate of the silver rate per gram, per 10 grams and per kilogram in India, and includes a weight calculator so you can estimate the value of silver you plan to buy or sell."}]
2b:["$","div","How to use the silver rate tool",{"className":"space-y-3","children":[["$","h3",null,{"className":"font-display text-lg font-semibold","children":"How to use the silver rate tool"}],[["$","p","Check the per-gram, 10-gram and per-kg figures a",{"className":"text-sm leading-relaxed text-muted-foreground md:text-base","children":"Check the per-gram, 10-gram and per-kg figures at the top, then enter a weight in grams in the weight calculator. The tool multiplies the weight by the current estimated rate and shows the approximate value. For a kilogram, enter 1000 grams."}],["$","p","The figure is an estimate built from the interna",{"className":"text-sm leading-relaxed text-muted-foreground md:text-base","children":"The figure is an estimate built from the international silver price and the USD/INR rate. It is meant as a quick reference. Your local jeweller’s price will be higher because it includes import duty effects, GST and making charges."}]],["$","ul",null,{"className":"list-disc space-y-1.5 pl-5 text-sm text-muted-foreground","children":[["$","li","Rate per gram: useful for small purchases such as coins",{"children":"Rate per gram: useful for small purchases such as coins"}],["$","li","Rate per 10 grams: the unit many jewellers quote",{"children":"Rate per 10 grams: the unit many jewellers quote"}],["$","li","Rate per kg: the unit used for bars and wholesale deals",{"children":"Rate per kg: the unit used for bars and wholesale deals"}]]}],["$","div",null,{"className":"flex justify-center py-2","children":["$","aside",null,{"aria-label":"Advertisement","data-cv-ad-zone":"mrec","className":"mx-auto flex w-fit max-w-full flex-col items-center","children":[["$","p",null,{"className":"mb-1.5 text-center text-[9px] font-medium uppercase tracking-[0.14em] text-muted-foreground/70","children":"Ad"}],["$","$L36",null,{"slotKey":"inArticle","width":300,"height":250}]]}]}]]}]
2c:["$","div","What decides the silver price in India",{"className":"space-y-3","children":[["$","h3",null,{"className":"font-display text-lg font-semibold","children":"What decides the silver price in India"}],[["$","p","Three things drive the price: the international ",{"className":"text-sm leading-relaxed text-muted-foreground md:text-base","children":"Three things drive the price: the international silver price quoted in US dollars per troy ounce, the USD/INR exchange rate, and Indian import duty and taxes. When the rupee weakens against the dollar, silver becomes more expensive in rupees even if the global price does not move."}],["$","p","Silver is also an industrial metal used in solar",{"className":"text-sm leading-relaxed text-muted-foreground md:text-base","children":"Silver is also an industrial metal used in solar panels, electronics and electric vehicles, so its price reacts to industrial demand as well as to investor interest. That makes it more volatile than gold."}]],null,null]}]
2d:["$","div","Buying silver: purity, making charges and GST",{"className":"space-y-3","children":[["$","h3",null,{"className":"font-display text-lg font-semibold","children":"Buying silver: purity, making charges and GST"}],[["$","p","Pure silver is 99.9% (999 fine). Jewellery is us",{"className":"text-sm leading-relaxed text-muted-foreground md:text-base","children":"Pure silver is 99.9% (999 fine). Jewellery is usually 92.5% sterling silver (925). Ask for a hallmark or a purity certificate, and check the weight on a calibrated scale. Making charges for jewellery can range from a few percent to well over 15% of the metal value, and GST is charged on both the metal and the making charges."}],["$","p","For investment, silver coins and bars from reput",{"className":"text-sm leading-relaxed text-muted-foreground md:text-base","children":"For investment, silver coins and bars from reputed refiners carry lower making charges than ornaments, but the resale price may still be lower than the buy price. Compare the buy-back policy before you purchase."}]],["$","ul",null,{"className":"list-disc space-y-1.5 pl-5 text-sm text-muted-foreground","children":[["$","li","Ask for the bill with weight, purity and making charges listed separately",{"children":"Ask for the bill with weight, purity and making charges listed separately"}],["$","li","Compare at least two sellers before buying",{"children":"Compare at least two sellers before buying"}],["$","li","Silver ETFs are another way to invest without storing the metal",{"children":"Silver ETFs are another way to invest without storing the metal"}]]}],null]}]
