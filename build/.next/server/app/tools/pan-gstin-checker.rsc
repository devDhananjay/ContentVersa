26:["$","div","How to use the PAN / GSTIN checker",{"className":"space-y-3","children":[["$","h3",null,{"className":"font-display text-lg font-semibold","children":"How to use the PAN / GSTIN checker"}],[["$","p","Choose the PAN or GSTIN tab, then type or paste ",{"className":"text-sm leading-relaxed text-muted-foreground md:text-base","children":"Choose the PAN or GSTIN tab, then type or paste the number. The tool checks the length, the pattern of letters and digits, and, for GSTIN, the checksum character. If the format is valid, it shows the decoded details such as the taxpayer type from the fourth character of the PAN and the state from the first two digits of the GSTIN."}],["$","p","A valid format does not prove the number belongs",{"className":"text-sm leading-relaxed text-muted-foreground md:text-base","children":"A valid format does not prove the number belongs to a real, active taxpayer. To confirm registration status, use the official search on the GST portal or the Income Tax e-filing portal."}]],["$","ul",null,{"className":"list-disc space-y-1.5 pl-5 text-sm text-muted-foreground","children":[["$","li","PAN pattern: five letters, four digits, one letter (for example ABCDE1234F)",{"children":"PAN pattern: five letters, four digits, one letter (for example ABCDE1234F)"}],["$","li","GSTIN pattern: two-digit state code, 10-character PAN, entity number, the letter Z and a checksum",{"children":"GSTIN pattern: two-digit state code, 10-character PAN, entity number, the letter Z and a checksum"}],["$","li","Format checks catch most typing errors",{"children":"Format checks catch most typing errors"}]]}],["$","div",null,{"className":"flex justify-center py-2","children":["$","aside",null,{"aria-label":"Advertisement","data-cv-ad-zone":"mrec","className":"mx-auto flex w-fit max-w-full flex-col items-center","children":[["$","p",null,{"className":"mb-1.5 text-center text-[9px] font-medium uppercase tracking-[0.14em] text-muted-foreground/70","children":"Ad"}],["$","